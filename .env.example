APP_NAME="Manager Library API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=manager_library
DB_USERNAME=library
DB_PASSWORD=
DB_SCHEMA=library,public

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
COVER_STORAGE_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
